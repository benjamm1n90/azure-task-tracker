<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>task-tracker-api-local</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- API docs / testing -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.0" />
    <!-- Swashbuckle 10.1.0 drags in Microsoft.OpenApi 2.3.0, which has a known
         high-severity advisory (GHSA-v5pm-xwqc-g5wc, stack-overflow DoS on
         circular schema refs). Pin the patched version directly. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />

    <!-- Data: Azure SQL Database via Entity Framework Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Secrets: pull the SQL connection string out of Azure Key Vault at startup,
         authenticating with the App Service's managed identity (no secrets in config files).
         EF Core 10 -> Microsoft.Data.SqlClient 6.1.1 requires Azure.Identity >= 1.14.2,
         so pin at least that high here too (bumped further to the current stable release). -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.2" />

    <!-- Observability: Azure Monitor / Application Insights -->
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />
  </ItemGroup>

</Project>
